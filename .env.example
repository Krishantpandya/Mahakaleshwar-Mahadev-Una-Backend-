NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=
ADMIN_SESSION_COOKIE=mankaleshwar_admin_session
ADMIN_SESSION_DAYS=7
# Used only by the one-time admin provisioning command. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Railway Volume mount path in production; local development uses ./data.
MEDIA_STORAGE_DIR=./data
MAX_UPLOAD_BYTES=20971520

# Optional Backblaze B2 credentials are retained for the future migration and announcement posters.
# Leave all five connection values empty until B2 is configured.
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_SIGNED_URL_TTL_SECONDS=900
