    "pg": "^8.16.3",
    "@fastify/cookie": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "@types/pg": "^8.15.5"
  }
}
